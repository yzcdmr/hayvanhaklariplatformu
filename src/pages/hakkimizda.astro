---
import BaseLayout from "../layouts/BaseLayout.astro";

const team = [
  { name: "Elif Kaya",    role: "Kurucu & Editör",          bio: "10 yıldır hayvan hakları aktivizmi yapan gazeteci. Çevre ve hayvan hakları alanında ödüllü yazılar kaleme aldı.", avatar: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200&q=80" },
  { name: "Mert Demir",   role: "Deniz Hayatı Muhabiri",    bio: "Biyolog ve çevre gazetecisi. Akdeniz ve Karadeniz'deki deniz canlılarının korunması üzerine araştırmalar yürütüyor.", avatar: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&q=80" },
  { name: "Selin Arslan", role: "Hukuk & Mevzuat",          bio: "Hayvan hakları alanında uzmanlaşmış avukat. Mevzuat takibi ve hukuki danışmanlık yapıyor.", avatar: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=200&q=80" },
  { name: "Ahmet Yılmaz", role: "Saha Muhabiri",            bio: "İstanbul ve çevresindeki kurtarma operasyonlarını takip eden bağımsız foto-muhabir.", avatar: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=200&q=80" },
];

const values = [
  { icon: "🔍", title: "Bağımsız Gazetecilik", desc: "Hiçbir siyasi ya da ticari çıkara bağlı değiliz. Haberlerimizi birincil kaynaklara ve saha verilerine dayandırıyoruz." },
  { icon: "⚖️", title: "Adalet Odaklı",        desc: "Hayvan hakları ihlallerini kayıt altına alarak faillerin hesap vermesini talep ediyoruz." },
  { icon: "🌍", title: "Sistematik Bakış",      desc: "Bireysel vakaların ötesinde yapısal sorunları görünür kılmaya çalışıyoruz." },
  { icon: "🤝", title: "Şeffaf Yapı",           desc: "Platformumuzun nasıl finanse edildiği ve nasıl çalıştığı konusunda tam şeffaflık ilkesine bağlıyız." },
];
---

<BaseLayout title="Hakkımızda | Hayvan Hakları Platformu">

  <!-- Platform İlkeleri & Katılım Rehberi -->
  <section class="mx-auto max-w-7xl px-5 sm:px-8 py-20">
    <div class="text-center mb-12">
      <span class="section-label">Hayvan Hakları Platformu | Türkiye</span>
      <p class="mt-2 text-sm font-bold tracking-wide text-[#B5634B]">Sivil İzleme, Hak Savunuculuğu ve İletişim Ağı</p>
      <h1 class="section-title mt-3">Platform Gönüllüsü İlkeleri ve Katılım Rehberi</h1>
      <p class="mt-4 text-[#8A7B6F] max-w-2xl mx-auto">
        Hayvan Hakları Platformu | Türkiye; bağımsız, gönüllülük esaslı, hiçbir siyasi parti veya resmi makamla organik bağı bulunmayan bir sivil hak savunuculuğu ağıdır. Platform içinde yer alan tüm gönüllüler aşağıdaki temel çalışma prensiplerine tabidir:
      </p>
    </div>

    <!-- İlkeler -->
    <div class="grid gap-5 sm:grid-cols-2 mb-12">

      <div class="bg-white rounded-2xl border border-[#E8DDD2] p-6 flex gap-4">
        <div class="w-10 h-10 rounded-xl bg-[#F5EFE6] flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B5634B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
          <h3 class="font-black text-[#1C1814] mb-1.5">Çalışma Esası</h3>
          <p class="text-sm text-[#6B5E55] leading-relaxed">Platform bünyesindeki tüm faaliyetler tamamen karşılıksız ve gönüllülük esasına dayanır. Platform bağış kabul etmez ve maddi çıkar ilişkisi barındırmaz.</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-[#E8DDD2] p-6 flex gap-4">
        <div class="w-10 h-10 rounded-xl bg-[#F5EFE6] flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B5634B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        </div>
        <div>
          <h3 class="font-black text-[#1C1814] mb-1.5">Temsil Yetkisi</h3>
          <p class="text-sm text-[#6B5E55] leading-relaxed">Platform gönüllüsü olmak, tek başına kamu adına hareket etme veya platformu resmi olarak tek başına temsil etme yetkisi vermez.</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-[#E8DDD2] p-6 flex gap-4">
        <div class="w-10 h-10 rounded-xl bg-[#F5EFE6] flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B5634B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/></svg>
        </div>
        <div>
          <h3 class="font-black text-[#1C1814] mb-1.5">Tarafsızlık</h3>
          <p class="text-sm text-[#6B5E55] leading-relaxed">Faaliyetlerde parti politikalarından, siyasi çekişmelerden ve mezhepsel yönelimlerden bağımsız, tamamen hayvan hakları merkezli bir tutum izlenir.</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl border border-[#E8DDD2] p-6 flex gap-4">
        <div class="w-10 h-10 rounded-xl bg-[#F5EFE6] flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B5634B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div>
          <h3 class="font-black text-[#1C1814] mb-1.5">İletişim ve Dil</h3>
          <p class="text-sm text-[#6B5E55] leading-relaxed">Resmi yazışmalarda ve kamuoyu açıklamalarında ayrıştırıcı, suçlayıcı bir dil yerine birleştirici, yapıcı ve hukuki zeminli bir üslup benimsenir.</p>
        </div>
      </div>

    </div>

    <!-- Hukuki Dayanak Notu -->
    <div class="rounded-2xl border-l-4 border-[#B5634B] bg-[#FDF9F3] border border-[#E8DDD2] p-6 sm:p-8">
      <div class="flex gap-3 items-start">
        <div class="w-8 h-8 rounded-lg bg-[#B5634B]/10 flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#B5634B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <div>
          <h4 class="font-black text-[#1C1814] mb-2 text-sm uppercase tracking-wide">Hukuki Dayanak Notu</h4>
          <p class="text-sm text-[#6B5E55] leading-relaxed">
            T.C. Anayasası M.26, M.34 ve M.74; 3071 sayılı Kanun ve 4982 sayılı Kanun kapsamında yürütülen gönüllülük esaslı sivil hak savunuculuğu, başvuru ve iletişim faaliyetidir.
          </p>
          <p class="text-sm text-[#8A7B6F] leading-relaxed mt-2">
            Hayvan Hakları Platformu | Türkiye tüzel kişiliğe sahip bir kamu kurumunu, siyasi partiyi veya resmi makamı temsil etmez. “Türkiye” ibaresi, ülke genelindeki sivil iletişim ve gönüllü uyarıcılığından oluşan kapsamı ifade eder.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values (şimdilik gizli — tekrar göstermek için yorum satırlarını kaldırın) -->
  {/*
  <section class="bg-[#F5EFE6] py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="text-center mb-12">
        <span class="section-label">İlkelerimiz</span>
        <h2 class="section-title">Neye İnanıyoruz?</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {values.map(v => (
          <div class="bg-white rounded-2xl border border-[#E8DDD2] p-6 text-center hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
            <div class="text-4xl mb-4">{v.icon}</div>
            <h3 class="font-black text-[#1C1814] mb-2">{v.title}</h3>
            <p class="text-sm text-[#6B5E55] leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  */}

  <!-- Team -->
  <section class="mx-auto max-w-7xl px-5 sm:px-8 py-20">
    <div class="text-center mb-12">
      <span class="section-label">Ekibimiz</span>
      <h2 class="section-title">Bu Sesi Yükseltiyoruz</h2>
      <p class="mt-4 text-[#8A7B6F] max-w-xl mx-auto">
        Gönüllülük esasıyla çalışan, farklı uzmanlık alanlarından gelen bir ekibiz.
      </p>
    </div>
    <!--<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {team.map(member => (
        <div class="card text-center p-6 group">
          <div class="w-20 h-20 rounded-full overflow-hidden mx-auto mb-4 ring-4 ring-[#F5EFE6] group-hover:ring-[#B5634B] transition-all">
            <img src={member.avatar} alt={member.name} class="w-full h-full object-cover" />
          </div>
          <h3 class="font-black text-[#1C1814]">{member.name}</h3>
          <p class="text-xs font-semibold text-[#B5634B] mt-1 mb-3">{member.role}</p>
          <p class="text-sm text-[#6B5E55] leading-relaxed">{member.bio}</p>
        </div>
      ))}
    </div>-->
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-7xl px-5 sm:px-8 py-20 text-center">
    <h2 class="section-title mb-4">Bu Davada Yer Almak İster Misiniz?</h2>
    <p class="text-[#8A7B6F] max-w-xl mx-auto mb-8">
      Gönüllü muhabir, fotoğrafçı, hukuk danışmanı veya sosyal medya katkıcısı olarak ekibimize katılabilirsiniz.
    </p>
    <a href="/iletisim" class="btn-accent text-lg px-8 py-4">Gönüllü Olmak İstiyorum</a>
  </section>

</BaseLayout>
