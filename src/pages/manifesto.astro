---
import BaseLayout from "../layouts/BaseLayout.astro";

const steps = [
  {
    number: "01",
    title: "Hukuki Statümüz ve Çalışma Esaslarımız",
    lead: "HAYVAN HAKLARI PLATFORMU TÜRKİYE, tüzel kişiliği bulunmayan, bağımsız ve gönüllü bir sivil çalışma ve dayanışma ağıdır.",
    body: [
      "Platform; dernek, vakıf, federasyon, konfederasyon, siyasi parti veya kamu kurumu değildir. Herhangi bir kamu kurumunu temsil etmez; kamu adına karar alma, kamu gücü kullanma veya idari işlem tesis etme yetkisi bulunduğu iddiasında değildir.",
      "Platformun faaliyetleri; yurttaşların örgütlenme, ifade, bilgi edinme, başvuru ve hukuki yollara müracaat etme özgürlükleri çerçevesinde, yürürlükteki mevzuata uygun olarak yürütülür.",
    ],
    // Metin blokları: string = paragraf, string[] = madde listesi
    sections: [
      {
        title: "Hukuki Statümüz",
        content: [
          "HAYVAN HAKLARI PLATFORMU TÜRKİYE, 5253 sayılı Dernekler Kanunu kapsamında kurulmuş bir dernek veya tüzel kişilik değildir.",
          "Platform, ortak bir amaç etrafında bir araya gelen gönüllülerin;",
          [
            "iletişim ve koordinasyon,",
            "saha gözlemi ve tanıklık,",
            "bilgi ve belge paylaşımı,",
            "kamuoyunu bilgilendirme,",
            "mevzuat ve uygulamaların izlenmesi,",
            "yetkili mercilere başvuru yapılmasına yönelik dayanışma",
          ],
          "faaliyetlerini yürüttüğü bağımsız bir sivil çalışma ağıdır.",
          "Bu yapılanma, kendisini herhangi bir kamu makamı veya resmî kurum olarak tanımlamaz.",
        ],
      },
      {
        title: "Anayasal Dayanak",
        content: [
          "Platformun sivil faaliyetleri, başta Türkiye Cumhuriyeti Anayasası’nın temel hak ve özgürlüklere ilişkin hükümleri olmak üzere yürürlükteki mevzuat çerçevesinde değerlendirilir.",
          "Bu kapsamda özellikle;",
          [
            "Anayasa’nın 25. maddesi düşünce ve kanaat özgürlüğünü,",
            "Anayasa’nın 26. maddesi düşünceyi açıklama ve yayma özgürlüğünü,",
            "Anayasa’nın 33. maddesi dernek kurma ve örgütlenme özgürlüğünü,",
            "Anayasa’nın 74. maddesi ise vatandaşların yetkili makamlara ve Türkiye Büyük Millet Meclisine yazı ile başvurma hakkını güvence altına almaktadır.",
          ],
          "Platform faaliyetleri, bu hakların kullanılmasının bir parçası olarak; hukuka, kişilik haklarına, özel hayatın korunmasına ve diğer yasal sınırlamalara riayet edilerek gerçekleştirilir.",
        ],
      },
      {
        title: "5253 Sayılı Kanun Bakımından Statümüz",
        content: [
          "Platform, 5253 sayılı Dernekler Kanunu kapsamında bir dernek olarak faaliyet göstermemektedir.",
          "Bu nedenle platformun;",
          [
            "dernek tüzel kişiliğine sahip olduğu,",
            "dernek adına kamu kurumu niteliğinde işlem yaptığı,",
            "dernek statüsünden kaynaklanan yetkilere sahip olduğu",
          ],
          "şeklinde bir değerlendirme yapılamaz.",
          "Platformun varlığı ve faaliyetleri, kendisini bir dernek olarak tanımlamasına değil, gönüllülerin ortak amaç doğrultusunda gerçekleştirdiği sivil iletişim, dayanışma ve çalışma faaliyetlerine dayanmaktadır.",
        ],
      },
      {
        title: "“Türkiye” İbaresinin Kullanımı",
        content: [
          "Platform adında yer alan “TÜRKİYE” ibaresi, platformun faaliyet ve iletişim ağının Türkiye genelindeki kapsamını ifade eden bir isim unsurudur.",
          "Bu kullanım;",
          ["devlet kurumu,", "kamu kurumu,", "resmî makam,", "kamu tüzel kişiliği"],
          "iddiası veya böyle bir izlenim oluşturma amacı taşımaz.",
          "Platform, hiçbir şekilde devletin, bir bakanlığın, belediyenin veya başka bir kamu kurumunun resmî temsilcisi olduğunu ileri sürmez.",
        ],
      },
      {
        title: "Kamuoyunu Bilgilendirme ve İfade Özgürlüğü",
        content: [
          "Platform ve gönüllüleri; hayvanların yaşam hakkı, hayvanlara yönelik uygulamalar, mevzuatın uygulanması ve kamu hizmetlerinin yürütülmesi hakkında, hukuka uygun şekilde bilgi paylaşabilir ve kamuoyunu bilgilendirebilir.",
          "Bu kapsamda yapılan açıklama, haber, değerlendirme ve saha paylaşımlarında;",
          [
            "doğrulanabilir bilgi esas alınır,",
            "kişilik haklarına ve özel hayatın gizliliğine riayet edilir,",
            "kesinleşmemiş iddialar mümkün olduğunca iddia niteliği açıkça belirtilerek aktarılır,",
            "kamu kurumları veya kişiler hakkında gerçeğe aykırı isnatlarda bulunulmamasına özen gösterilir.",
          ],
        ],
      },
      {
        title: "Bilgi Edinme ve Resmî Makamlara Başvuru",
        content: [
          "Platform gönüllüleri, mevzuatın kendilerine tanıdığı haklar kapsamında yetkili kamu kurumlarına başvurarak bilgi ve belge talep edebilir; dilekçe, ihbar, şikâyet ve diğer hukuki başvuru yollarını kullanabilir.",
          "Bu kapsamda 4982 sayılı Bilgi Edinme Hakkı Kanunu, 3071 sayılı Dilekçe Hakkının Kullanılmasına Dair Kanun ve ilgili diğer mevzuatın hükümleri uygulanır.",
          "Platform, kamu kurumlarının yerine geçmez; kamu kurumlarından bilgi talep edilmesi veya idari uygulamaların izlenmesi, herhangi bir kamu yetkisinin kullanıldığı anlamına gelmez.",
        ],
      },
      {
        title: "Saha Çalışmaları ve Belgeleme",
        content: [
          "Platform gönüllülerinin gerçekleştirdiği saha çalışmaları; gözlem, fotoğraf, video, tanıklık ve kamuya açık bilgiler üzerinden durum tespiti ve raporlama amacı taşıyabilir.",
          "Bu çalışmalar sırasında;",
          [
            "kamu görevlisi veya kolluk görevlisi gibi hareket edilmez,",
            "özel mülkiyet alanlarına hukuka aykırı şekilde girilmez,",
            "kişisel veriler ve özel hayatın gizliliği korunur,",
            "elde edilen bilgi ve görüntüler hukuka uygun biçimde değerlendirilir.",
          ],
          "Platform tarafından hazırlanan rapor ve kayıtlar, gerektiğinde yetkili idari veya adli mercilere sunulabilir.",
        ],
      },
      {
        title: "Hukuki Dayanışma",
        content: [
          "Platform, hayvan hakları ve yaşam hakkı alanında çalışan hukukçular, uzmanlar ve gönüllüler arasında bilgi paylaşımı ve hukuki dayanışmayı destekleyebilir.",
          "Platformun kendisi avukatlık faaliyeti yürütmez ve hukuki danışmanlık hizmeti veren bir hukuk bürosu değildir.",
          "Somut hukuki işlemler, dava, suç duyurusu, idari başvuru veya diğer hukuki süreçler bakımından gerekli mesleki faaliyetler, yetkili hukukçular tarafından ve yürürlükteki mevzuata uygun şekilde gerçekleştirilir.",
        ],
      },
      {
        title: "Bağımsızlık ve Siyasi Tarafsızlık",
        content: [
          "HAYVAN HAKLARI PLATFORMU TÜRKİYE;",
          [
            "herhangi bir siyasi partinin,",
            "kamu kurumunun,",
            "ticari kuruluşun,",
            "dernek veya federasyonun",
          ],
          "resmî organı veya temsilcisi değildir.",
          "Platformun temel amacı, hayvanların yaşam hakkı ve hukukun üstünlüğü konusunda sivil izleme, dayanışma, bilgilendirme ve yasal yolların kullanılmasını desteklemektir.",
        ],
      },
      {
        title: "Sorumluluk Sınırı",
        content: [
          "Platform tarafından yayımlanan içerikler, saha bildirimleri, değerlendirmeler ve kamuoyu açıklamaları; mevcut bilgi ve belgeler temelinde hazırlanır.",
          "Platform, hiçbir kişi veya kurum hakkında kesinleşmiş bir yargı kararı bulunmadığı hâlde kişileri suçlu ilan etmez.",
          "Kamuoyuna aktarılan iddialar ile kesinleşmiş yargı kararları birbirinden ayrılır.",
          "Platformun internet sitesi ve sosyal medya hesaplarında yayımlanan içerikler, aksi açıkça belirtilmedikçe resmî kamu kurumu açıklaması veya kamu makamı kararı niteliğinde değildir.",
        ],
      },
    ],
    principle: {
      title: "Temel İlke",
      intro: "HAYVAN HAKLARI PLATFORMU TÜRKİYE’nin çalışma anlayışı;",
      lines: [
        "Yaşam hakkını savunmak,",
        "hukuku izlemek,",
        "ihlalleri belgelemek,",
        "kamuoyunu bilgilendirmek",
        "ve hukuki yolları kullanmaktır.",
      ],
      outro: "Platform, tüm faaliyetlerini hukukun üstünlüğü, şeffaflık, gönüllülük, kamu yararı ve hayvanların yaşam hakkına saygı ilkeleri doğrultusunda sürdürür.",
    },
  },
];
---

<BaseLayout title="Manifesto | Hayvan Hakları Platformu" description="Yaşam hakkı pazarlık konusu değildir. Hayvan Hakları Türkiye Platformu manifestosu.">

  <!-- HERO -->
  <section class="bg-[#1C1814] text-white pt-20 pb-28 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 pointer-events-none">
      <div class="absolute top-10 left-10 w-96 h-96 bg-[#B5634B] rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-0 w-80 h-80 bg-[#5C7A5E] rounded-full blur-3xl"></div>
    </div>
    <div class="relative z-10 mx-auto max-w-4xl px-5 sm:px-8">
      <span class="section-label">Manifestomuz</span>
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black leading-tight mt-4 text-white">
        Yaşam hakkı<br/>
        <span class="text-[#D4856E]">pazarlık konusu</span><br/>
        değildir.
      </h1>
      <p class="mt-8 text-xl text-[#C4B5AB] leading-relaxed max-w-2xl">
        Biz, yaşam hakkının yalnızca insana ait olmadığını savunan bağımsız bir farkındalık platformuyuz.
        Şiddetin, ihmalin ve sessiz bırakılan her canın karşısında duruyoruz.
      </p>
    </div>
  </section>

  <!-- 4 STEPS -->
  <section class="mx-auto max-w-5xl px-5 sm:px-8 py-16 space-y-24">

    {steps.map((step, i) => (
      <div>
      <div class="max-w-3xl">

        <!-- Text -->
        <div>
          <h2 class="text-2xl sm:text-3xl font-black text-[#1C1814] leading-snug mb-5">
            {step.title}
          </h2>
          <p class="text-[#6B5E55] text-lg font-medium leading-relaxed mb-5 border-l-2 border-[#E8DDD2] pl-4 italic">
            {step.lead}
          </p>
          <div class="space-y-4">
            {step.body.map(para => (
              <p class="text-[#6B5E55] leading-relaxed">{para}</p>
            ))}
          </div>
        </div>

      </div>

      {step.sections && (
        <div class="mt-14 grid gap-5 md:grid-cols-2">
          {step.sections.map((sec, j) => (
            <article class="rounded-3xl border border-[#E8DDD2] bg-white p-7 shadow-sm">
              <div class="flex items-start gap-4 mb-4">
                <span class="flex-shrink-0 w-9 h-9 rounded-xl bg-[#F5EDE6] text-[#B5634B] font-black text-sm flex items-center justify-center">
                  {String(j + 1).padStart(2, "0")}
                </span>
                <h3 class="text-lg font-black text-[#1C1814] leading-snug pt-1">{sec.title}</h3>
              </div>
              <div class="space-y-3 text-[#6B5E55] leading-relaxed text-[0.95rem]">
                {sec.content.map(block => Array.isArray(block) ? (
                  <ul class="space-y-1.5 pl-1">
                    {block.map(item => (
                      <li class="flex gap-2.5">
                        <span class="mt-2.5 w-1.5 h-1.5 rounded-full bg-[#B5634B] flex-shrink-0"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p>{block}</p>
                ))}
              </div>
            </article>
          ))}
        </div>
      )}

      {step.principle && (
        <div class="mt-8 rounded-3xl bg-[#1C1814] text-white px-8 py-10 sm:px-12 relative overflow-hidden">
          <div class="absolute -bottom-20 -left-16 w-72 h-72 bg-[#B5634B]/20 rounded-full blur-3xl pointer-events-none"></div>
          <div class="relative z-10">
            <span class="text-xs font-bold tracking-[0.2em] uppercase text-[#D4856E] block mb-3">
              {String(step.sections.length + 1).padStart(2, "0")} · {step.principle.title}
            </span>
            <p class="text-[#C4B5AB] mb-5">{step.principle.intro}</p>
            <p class="text-2xl sm:text-3xl font-black leading-snug uppercase tracking-tight">
              {step.principle.lines.map(line => <span class="block">{line}</span>)}
            </p>
            <p class="mt-6 text-[#C4B5AB] leading-relaxed max-w-3xl">{step.principle.outro}</p>
          </div>
        </div>
      )}
      </div>
    ))}

  </section>

  <!-- CLOSING QUOTE -->
  <section class="mx-auto max-w-4xl px-5 sm:px-8 pb-20">
    <div class="bg-[#1C1814] text-white rounded-3xl px-10 py-12 relative overflow-hidden">
      <div class="absolute -top-16 -right-16 w-64 h-64 bg-[#B5634B]/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10">
        <p class="text-2xl sm:text-3xl font-black leading-relaxed mb-6">
          "Biz tarafız. Yaşamdan, adaletten, vicdandan
          ve sessiz bırakılan canlardan tarafız."
        </p>
        <p class="text-[#8A7B6F] text-sm">— Hayvan Hakları Türkiye Platformu</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/haberler" class="btn-accent">Son Haberlere Git</a>
          <a href="/iletisim" class="btn-primary">Bizimle İletişime Geç</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
